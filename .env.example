# Local path to the authoritative Blender building collection.
BUILDING_BLEND_FILE=/absolute/path/to/2026-export-low-poly-textured-buildings.blend

# Directory containing source textures referenced by the Blender file.
BUILDING_TEXTURE_ROOT=/absolute/path/to/blender

# Separate Blender scene populated from the deterministic synthetic-city plan.
CITY_LOOKDEV_BLEND_FILE=/absolute/path/to/2026-city-lookdev.blend

# Optional when Blender is installed somewhere else.
# BLENDER_EXECUTABLE=/absolute/path/to/Blender
