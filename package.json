{
  "name": "city-field",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "preprocess": "npm run preprocess:structure && npm run preprocess:blocks",
    "preprocess:structure": "tsx scripts/preprocess-osm.ts",
    "preprocess:blocks": "tsx scripts/preprocess-blocks.ts",
    "catalog:build": "tsx scripts/catalog-building-assets.ts",
    "catalog:watch": "tsx scripts/catalog-building-assets.ts --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview"
  },
  "dependencies": {
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@turf/polygonize": "^7.3.5",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.1.2",
    "@types/three": "^0.185.3",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
